#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

if [ -f /var/www/html/package.json ] && [ -x /var/www/html/node_modules/.bin/puppeteer ]; then
    mkdir -p "$PUPPETEER_CACHE_DIR"
    chown -R sail:sail "$(dirname "$PUPPETEER_CACHE_DIR")"

    if ! find "$PUPPETEER_CACHE_DIR" -type f -path '*/chrome-headless-shell/*/chrome-headless-shell' -print -quit | grep -q .; then
        echo "Installing Puppeteer's Chrome headless shell..."
        gosu sail npm exec -- puppeteer browsers install chrome-headless-shell
    fi
fi

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
